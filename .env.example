# ==============================================================================
# CERTIFICAMASTER - VARIÁVEIS DE AMBIENTE (PRODUÇÃO / VERCEL / SUPABASE)
# ==============================================================================

# 1. Conexão com o Supabase (Obrigatório para autenticação, nuvem e validação de QR Code)
# Obtenha em: https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. URL Canônica da Aplicação na Vercel (Usada para gerar links de QR Code nos certificados)
# Exemplo: https://certificamaster.vercel.app
VITE_APP_URL=https://seu-projeto.vercel.app

# 3. Chaves Globais de Inteligência Artificial (Opcional - se desejar definir no servidor)
# Se não preenchidas aqui, cada operador pode continuar inserindo as suas chaves gratuitas diretamente no navegador.
VITE_GEMINI_API_KEY=
VITE_GROQ_API_KEY=
VITE_OPENROUTER_API_KEY=
